# Offline campaigns and installed Python packages require no environment variables.
# SAGE does not read .env automatically. For optional network translation:
#   cp .env.example .env
#   fill the key/model, then use: uv run --env-file .env sage ...
# See docs/getting-started.md#optional-environment-settings.

# Only for --provider openai with the earlier Rust tensor profile.
OPENAI_API_KEY=
SAGE_MODEL=

# Future adapter development; current Einsums profiles do not support SAM.
SAGE_SAM_ENDPOINT=

# Optional source-development overrides. Installed packages find their libraries.
# Use absolute paths; Linux libraries end in .so instead of .dylib.
# EINSUMS_RS_LIBRARY=/absolute/path/to/libsage_einsums.dylib
# EINSUMS_CPP_LIBRARY=/absolute/path/to/libsage_einsums_cpp.dylib
