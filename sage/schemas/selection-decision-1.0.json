{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sage-equivalence.local/schemas/selection-decision-1.0.json",
  "title": "SAGE human target-selection decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_kind", "decision_id", "target", "status",
    "approved_by", "approved_at", "rationale", "evidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision_kind": {"const": "target-selection"},
    "decision_id": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "status": {"const": "APPROVED"},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "minLength": 1},
    "rationale": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}}
  }
}
